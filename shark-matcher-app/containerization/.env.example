# shark-matcher-app — environment configuration
#
# Copy this file to .env in the same directory and edit as needed.
# Docker Compose automatically reads a .env file placed alongside docker-compose.yml.
#
#   cp .env.example .env
#
# Values here override the defaults baked into docker-compose.yml and the
# application. Uncomment and edit only the variables you need to change.

# ── Inference Service ──────────────────────────────────────────────────────────
#
# URL of the shark-matcher inference service.
# When running via Docker Compose this resolves automatically via Docker's
# internal DNS — the default below matches the service name in docker-compose.yml.
# Override when pointing the app at a remote or separately managed instance.
#
INFERENCE_SERVICE_URL=http://shark-matcher:8000

# Model selection, training notifications and Gmail credentials belong to the
# matcher; shark-matcher/containerization/.env.example lists them.

# ── Testing ────────────────────────────────────────────────────────────────────
#
# Set to "true" to use the test database. Never set this in a production
# environment.
#
#SHARK_TEST_MODE=false
