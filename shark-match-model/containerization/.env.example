# shark-match-model — environment configuration
#
# Copy this file to .env and edit as needed.
# Docker Compose automatically reads a .env file placed alongside docker-compose.yml.
#
#   cp .env.example .env

# ── Model Configuration ────────────────────────────────────────────────────────
#
# Comma-separated DISPLAY_NAME:MODE:RERANK:EMBEDDING_SET:CHECKPOINT entries; the root README
# section "Configuring Models and Retrieval" owns the format. Unset, the demo bundle model loads.
#
#SHARK_MODELS=MiewID Multimodal:multimodal:kreciprocal:pre2019-sample-data:omega_miew_arcface_random

# Comma-separated alias:directory_name pairs for the model alias resolver.
# Allows frontend clients to refer to models by a friendly name (e.g. "ViT")
# instead of the internal directory name (e.g. "vit_triplet").
# Add new models here without touching source code.
#
MODEL_ALIASES=ViT:vit_triplet,Miew:miew

# ── External Module Paths ──────────────────────────────────────────────────────
#
# Override the default sibling-directory location for the optional pairx checkout.
# The default assumes it is cloned as a sibling of shark-match-model/; use an absolute path.
#
#PAIRX_ROOT=PAIRX_CHECKOUT_DIRECTORY

# ── Gmail Notifications ────────────────────────────────────────────────────────
#
# Credentials for sending training completion/error emails via the Gmail API.
# Replaces the file-based token.json / credentials.json workflow.
#
# GMAIL_CLIENT_ID and GMAIL_CLIENT_SECRET come from your Google Cloud OAuth
# client (credentials.json).  GMAIL_REFRESH_TOKEN is the long-lived token
# from token.json — it is used to obtain fresh access tokens automatically.
#
# When all three are set, no credential files are required on disk.
#
#GMAIL_CLIENT_ID=
#GMAIL_CLIENT_SECRET=
#GMAIL_REFRESH_TOKEN=

# Comma-separated addresses that receive training completion emails; unset sends none.
#
#SHARK_NOTIFICATION_EMAILS=
